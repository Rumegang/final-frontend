rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'andreaserr@gmail.com';
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /destinationReviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'destinationId',
          'userId',
          'userName',
          'rating',
          'comment',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'destinationId',
          'userId',
          'userName',
          'rating',
          'comment',
          'createdAt'
        ])
        && request.resource.data.id == reviewId
        && request.resource.data.destinationId is string
        && exists(/databases/$(database)/documents/destinations/$(request.resource.data.destinationId))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /users/{userId}/private/favorites {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/itineraries/{itineraryId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
